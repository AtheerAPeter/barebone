#!/usr/bin/with-contenv bash
# The desktop's bar (waybar, /etc/xdg/waybar): buttons for Barebone, Files and
# Terminal, and the open windows. A service of its own, not in autostart: the
# desktop runs autostart again each time Barebone restarts.

if [[ "${PIXELFLUX_WAYLAND,,}" != "true" ]]; then
  exec sleep infinity
fi

# The desktop's own Wayland display (labwc's), once it is up.
SOCKET="${XDG_RUNTIME_DIR}/wayland-0"
while [ ! -e "${SOCKET}" ]; do
  sleep 0.5
done

cd "${HOME}"
# waybar needs a D-Bus session, which this minimal desktop does not start.
exec s6-setuidgid abc env WAYLAND_DISPLAY=wayland-0 dbus-run-session -- waybar
