// The desktop's bar, at the bottom: Barebone, Files and Terminal, then the open windows.
{
  "layer": "top",
  "position": "bottom",
  "height": 34,
  "modules-left": ["custom/barebone", "custom/files", "custom/terminal"],
  "modules-center": ["wlr/taskbar"],
  "custom/barebone": {
    "format": "Barebone",
    "tooltip-format": "Open Barebone",
    "on-click": "/usr/bin/barebone"
  },
  "custom/files": {
    "format": "Files",
    "tooltip-format": "Browse files",
    "on-click": "/usr/bin/pcmanfm"
  },
  "custom/terminal": {
    "format": "Terminal",
    "tooltip-format": "Open a terminal",
    "on-click": "/usr/bin/foot"
  },
  "wlr/taskbar": {
    "format": "{title}",
    "tooltip-format": "{title}",
    "on-click": "activate",
    "on-click-middle": "close",
    "max-length": 40
  }
}
