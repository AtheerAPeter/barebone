#!/bin/sh
# Barebone on a screen of its own that no one sees (Xvfb): it is used through
# its remote link. When it quits, so does the container, and Docker starts
# it again (compose.yml).
#
# The browser's passwords are kept in a file of Barebone's (--password-store),
# as there is no keyring.
exec xvfb-run --auto-servernum --server-args='-screen 0 1920x1080x24 -nolisten tcp' \
  /opt/barebone/barebone --password-store=basic "$@"
